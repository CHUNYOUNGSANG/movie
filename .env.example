# 이 파일을 .env로 복사하고 실제 값을 채우세요
# cp .env.example .env

# DB 설정
DB_ROOT_PASSWORD=rootpassword
DB_USER=moviebot
DB_PASSWORD=moviepass

# 텔레그램 설정 (BotFather에서 발급)
# 구독자는 봇에 /start 를 보내면 자동 DB 등록됩니다
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# API 토큰(JWT) 서명 키: 32자 이상 임의 문자열 (예: openssl rand -base64 48)
# 비워 두면 시작할 때마다 새로 만들어져 재시작 시 로그인이 풀림. 서버가 여러 대면 반드시 같은 값으로 설정
AUTH_JWT_SECRET=

# 크론 스케줄 (기본: 5분마다)
MOVIE_CHECK_CRON=0 */5 * * * *
